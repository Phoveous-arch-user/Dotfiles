* {
    background: rgba(40, 49, 61, 0.7);
    primary: #b0c8ec;
    primary-fixed: #d2e4ff;
    primary-fixed-dim: #b0c8ec;
    on-primary: #18324e;
    on-primary-fixed: #001c37;
    on-primary-fixed-variant: #304866;
    primary-container: #4b6382;
    on-primary-container: #ffffff;
    secondary: #bec7d7;
    secondary-fixed: #dae3f3;
    secondary-fixed-dim: #bec7d7;
    on-secondary: #28313d;
    on-secondary-fixed: #131c27;
    on-secondary-fixed-variant: #3f4754;
    secondary-container: #414a57;
    on-secondary-container: #dce4f5;
    tertiary: #e1bae0;
    tertiary-fixed: #ffd6fd;
    tertiary-fixed-dim: #e1bae0;
    on-tertiary: #422644;
    on-tertiary-fixed: #2b112e;
    on-tertiary-fixed-variant: #5a3c5c;
    tertiary-container: #775778;
    on-tertiary-container: #ffffff;
    error: #ffb4ab;
    on-error: #690005;
    error-container: #93000a;
    on-error-container: #ffdad6;
    surface: #121315;
    on-surface: #e3e2e5;
    on-surface-variant: #c4c6ce;
    outline: #8d9198;
    outline-variant: #43474d;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #e3e2e5;
    inverse-on-surface: #2f3033;
    inverse-primary: #48607f;
    surface-dim: #121315;
    surface-bright: #38393b;
    surface-container-lowest: #0d0e10;
    surface-container-low: #1a1c1e;
    surface-container: #1f2022;
    surface-container-high: #292a2c;
    surface-container-highest: #343537;
}
