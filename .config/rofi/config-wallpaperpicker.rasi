/* wallpaper-picker.rasi — horizontal strip of wallpaper thumbnails */
/* Opened by ~/.config/hypr/scripts/wallpaper-picker.sh              */

configuration {
    modi:             "dmenu";
    font:             "Fira Sans 11";
    show-icons:       true;
    icon-theme:       "Tela-circle-dracula";
    hover-select:     true;      /* hover highlights the entry under the cursor */
    scroll-method:    1;         /* centered scrolling                          */
    click-to-exit:    true;      /* apply on click                              */
    close-on-delete:  false;
    me-select-entry:  "";        /* selection follows hover, not clicks         */
    me-accept-entry:  "MousePrimary";
    kb-cancel:        "Escape";
    kb-accept:        "Return,KP_Enter";
}

@theme "~/.config/rofi/colors.rasi"
@import "~/.cache/ml4w/hyprland-dotfiles/current_wallpaper.rasi"

/* ---- Main ---- */
window {
    width:                       72em;
    location:                    center;
    anchor:                      center;
    spacing:                     0em;
    padding:                     0em;
    margin:                      0em;
    color:                       #FFFFFF;
    border:                      2px;
    border-color:                @primary;
    border-radius:               18px;
    background-color:            @background;
    transparency:                "real";
    cursor:                      "default";
}

mainbox {
    enabled:                     true;
    spacing:                     0em;
    orientation:                 vertical;
    children:                    [ "inputbar", "listview" ];
    background-color:            transparent;
    background-image:            @current-image;
}

/* ---- Search bar ---- */
inputbar {
    enabled:                     true;
    spacing:                     0em;
    padding:                     0.8em;
    children:                    [ "textbox-prompt-colon", "entry" ];
    background-color:            @surface;
}

textbox-prompt-colon {
    enabled:                     true;
    expand:                      false;
    str:                         "    ";
    padding:                     0.5em 0.2em 0em 0.4em;
    text-color:                  @on-surface;
    background-color:            transparent;
}

entry {
    enabled:                     true;
    spacing:                     1em;
    padding:                     0.5em;
    background-color:            @surface;
    text-color:                  @on-surface;
    cursor:                      text;
    placeholder:                 "Pick a wallpaper";
    placeholder-color:           inherit;
}

/* ---- Thumbnail strip ---- */
listview {
    padding:                     0.6em;
    spacing:                     0.4em;
    margin:                      0em;
    enabled:                     true;
    flow:                        horizontal;
    columns:                     9;
    lines:                       1;
    cycle:                       false;
    dynamic:                     true;
    scrollbar:                   false;
    fixed-height:                true;
    fixed-columns:               true;
    cursor:                      "default";
    background-color:            transparent;
    text-color:                  @on-surface;
}

element {
    enabled:                     true;
    padding:                     0.3em;
    margin:                      0.1em;
    cursor:                      pointer;
    background-color:            transparent;
    text-color:                  @on-surface;
    border-radius:               0.8em;
    orientation:                 vertical;
}

element selected.normal {
    background-color:            @surface;
    text-color:                  @on-surface;
    border-radius:               0.8em;
    border:                      2px;
    border-color:                @primary;
}

element normal.normal {
    background-color:            inherit;
    text-color:                  @on-surface;
}

element normal.urgent {
    background-color:            inherit;
    text-color:                  @on-surface;
}

element normal.active {
    background-color:            inherit;
    text-color:                  @on-surface;
}

element selected.urgent {
    background-color:            inherit;
    text-color:                  @on-surface;
}

element selected.active {
    background-color:            inherit;
    text-color:                  @on-surface;
}

element-icon {
    size:                        8em;
    cursor:                      inherit;
    background-color:            transparent;
    text-color:                  inherit;
}

element-text {
    vertical-align:              0.5;
    horizontal-align:            0.5;
    cursor:                      inherit;
    background-color:            transparent;
    text-color:                  inherit;
}
