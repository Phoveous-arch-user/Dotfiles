/* theme-switcher picker — visual grid of curated themes */
configuration {
    modi:                       "dmenu";
    font:                       "Fira Sans 11";
    show-icons:                 true;
    icon-theme:                 "Tela-circle-dracula";
    hover-select:               false;
    scroll-method:              1;
    click-to-exit:              true;
    close-on-delete:            true;
    kb-cancel:                  "Escape,MousePrimary";
    kb-accept:                  "Return,KP_Enter";
}

@theme "~/.config/rofi/colors.rasi"
@import "~/.cache/ml4w/hyprland-dotfiles/current_wallpaper.rasi"

/* ---- Main ---- */
window {
    width:                       95em;
    location:                    center;
    anchor:                      center;
    spacing:                     0em;
    padding:                     0em;
    margin:                      0em;
    color:                       #FFFFFF;
    border:                      2px;
    border-color:                @primary;
    border-radius:               18px;
    background-color:            @background;
    transparency:                "real";
    cursor:                      "default";
    enabled:                     true;
}

mainbox {
    enabled:                     true;
    spacing:                     0em;
    orientation:                 horizontal;
    children:                    [ "listbox" ];
    background-color:            transparent;
    background-image:            @current-image;
}

/* ---- Input ---- */
inputbar {
    enabled:                     true;
    spacing:                     0em;
    padding:                     1em;
    background-color:            @surface;
}

textbox-prompt-colon {
    enabled:                     true;
    expand:                      false;
    str:                         "  ";
    padding:                     0.5em 0.2em 0em 0em;
    text-color:                  @on-surface;
    border-radius:               2em 0em 0em 2em;
    background-color:            transparent;
}

entry {
    enabled:                     true;
    spacing:                     1em;
    padding:                     0.5em;
    background-color:            @surface;
    text-color:                  @on-surface;
    cursor:                      text;
    placeholder:                 "Pick a theme";
    placeholder-color:           inherit;
}

/* ---- Grid ---- */
listbox {
    padding:                     0.5em;
    spacing:                     0em;
    orientation:                 vertical;
    children:                    [ "inputbar", "listview" ];
    background-color:            @background;
}

listview {
    padding:                     1em;
    spacing:                     1em;
    margin:                      0em;
    enabled:                     true;
    columns:                     3;
    lines:                       2;
    cycle:                       false;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;
    cursor:                      "default";
    background-color:            transparent;
    text-color:                  @on-surface;
}

element {
    enabled:                     true;
    padding:                     0.4em;
    margin:                      0.2em;
    cursor:                      pointer;
    background-color:            transparent;
    text-color:                  @on-surface;
    border-radius:               1em;
    orientation:                 vertical;
}

element selected.normal {
    background-color:            @surface;
    text-color:                  @on-surface;
    border-radius:               1.2em;
    border:                      2px;
    border-color:                @primary;
}

element normal.normal {
    background-color:            inherit;
    text-color:                  @on-surface;
}

element normal.urgent {
    background-color:            inherit;
    text-color:                  @on-surface;
}

element normal.active {
    background-color:            inherit;
    text-color:                  @on-surface;
}

element selected.urgent {
    background-color:            inherit;
    text-color:                  @on-surface;
}

element selected.active {
    background-color:            inherit;
    text-color:                  @on-surface;
}

element-icon {
    size:                        22em;
    cursor:                      inherit;
    background-color:            transparent;
    text-color:                  inherit;
}

element-text {
    vertical-align:              0.5;
    horizontal-align:            0.5;
    cursor:                      inherit;
    background-color:            transparent;
    text-color:                  inherit;
}
